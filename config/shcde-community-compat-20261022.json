  "tool_formats": [
    {
      "name": "AI-Toolkit",
      "format": ".aiv",
      "note": "Classic Crusader AI/UCP; do not reinterpret as DE .aivjson"
    },
    {
      "name": "Serpens AIVParser",
      "format": ".aivjson",
      "note": "Read-only DE blueprints, 100x100 grid; .baiv and classic .aiv excluded"
    },
    {
      "name": "Serpens MapParser",
      "format": ".map/.trail",
      "note": "Read-only PKWARE DCL/CRC; .sav/.msv unsupported"
    },
    {
      "name": "Serpens SaveExtractor",
      "format": ".sav",
      "note": "Read-only original save; extracts map, lords and active CPU AIV candidates to separate <Save-Name>.extracted directory, never overwrites existing output. MapParser itself does NOT parse .sav/.msv."
    },
    {
      "name": "Serpens TrailEditor",
      "format": ".trail",
      "note": "Lossless standalone export/build in separate outputs; V2.8 restart-format 60, multiplayer setup -12, editable trail.json/AIVJSON/lordjson/maps; not an in-game Save parser."
    },
    {
      "name": "Serpens AtlasBuilder",
      "format": "Override/Atlas/<GM group>/atlas.json + atlas.(png|dds) + optional mask",
      "note": "Script Extender Asset API Atlas format; SE>=2.4 for PNG and >=2.8 for BC7 DDS; separate from SpriteSuite Unity AssetBundle .v1/.v2. Prevent PNG+DDS duplicates, check pivots, PPU and mask."
    }
  ],
